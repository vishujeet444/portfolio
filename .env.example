# ============================================================
# Vishwajeet Kumar Portfolio — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local dev with `vercel dev`
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# --- Supabase (Required) ---
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# NOTE: Never commit the actual .env or .env.local file to Git.
# The .gitignore should already exclude it.
